{
  "name": "sqlpackage-installer",
  "version": "1.0.20",
  "description": "Installs a specific version of SqlPackage from the internet or the tools cache and adds it to the PATH. Use this task to change the version of SqlPackage used in subsequent tasks.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"const fs=require('fs');['dist','lib','node_modules_minimal','node_modules_temp','coverage'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}});fs.readdirSync('.').filter(f=>f.endsWith('.vsix')).forEach(f=>fs.unlinkSync(f))\"",
    "compile": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare-minimal": "powershell -ExecutionPolicy Bypass -File prepare-minimal.ps1",
    "restore-modules": "powershell -ExecutionPolicy Bypass -File restore-modules.ps1",
    "prepackage": "npm run build && npm run prepare-minimal",
    "postpackage": "npm run restore-modules",
    "package": "tfx extension create --manifest-globs vss-extension.json --output-path .",
    "install-tfx": "npm install -g tfx-cli"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroC88/Azure-pipelines-tasks.git"
  },
  "keywords": [
    "azure-devops",
    "extension",
    "sqlpackage"
  ],
  "author": "PedroC88",
  "license": "UNLICENSED",
  "dependencies": {
    "azure-pipelines-task-lib": "^5.2.4",
    "azure-pipelines-tool-lib": "^2.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^16.18.119",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "tfx-cli": "^0.22.6",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1"
  }
}