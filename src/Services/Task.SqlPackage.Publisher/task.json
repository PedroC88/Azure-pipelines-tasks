{
  "$schema": "https://raw.githubusercontent.com/Microsoft/azure-pipelines-task-lib/master/tasks.schema.json",
  "id": "f8a9c2d1-4e3b-4c5a-9d8f-2e1b3c4d5e6f",
  "name": "SqlPackagePublisher",
  "friendlyName": "SqlPackage Publisher",
  "description": "Deploy SQL Server dacpac files using SqlPackage",
  "helpMarkDown": "[More information](https://docs.microsoft.com/en-us/sql/tools/sqlpackage)",
  "category": "Deploy",
  "author": "PedroC88",
  "icon": "icon.png",
  "version": {
    "Major": 0,
    "Minor": 0,
    "Patch": 12
  },
  "instanceNameFormat": "Deploy $(dacpacFile) to $(databaseName)",
  "inputs": [
    {
      "name": "dacpacFile",
      "type": "filePath",
      "label": "DACPAC File",
      "defaultValue": "",
      "required": true,
      "helpMarkDown": "Path to the DACPAC file. Can include wildcards and variables like $(System.DefaultWorkingDirectory)/**/*.dacpac"
    },
    {
      "name": "targetMethod",
      "type": "pickList",
      "label": "Specify SQL Using",
      "defaultValue": "server",
      "required": true,
      "helpMarkDown": "Specify the target connection method",
      "options": {
        "server": "Server",
        "connectionString": "Connection String"
      }
    },
    {
      "name": "serverName",
      "type": "string",
      "label": "Server Name",
      "defaultValue": "",
      "required": true,
      "helpMarkDown": "SQL Server name or IP address. Example: localhost, myserver.database.windows.net",
      "visibleRule": "targetMethod = server"
    },
    {
      "name": "databaseName",
      "type": "string",
      "label": "Database Name",
      "defaultValue": "",
      "required": true,
      "helpMarkDown": "Name of the SQL Server database",
      "visibleRule": "targetMethod = server"
    },
    {
      "name": "authenticationType",
      "type": "pickList",
      "label": "Authentication",
      "defaultValue": "windowsAuthentication",
      "required": true,
      "helpMarkDown": "Select the authentication method",
      "visibleRule": "targetMethod = server",
      "options": {
        "windowsAuthentication": "Windows Authentication",
        "sqlServerAuthentication": "SQL Server Authentication",
        "azureActiveDirectory": "Azure Active Directory"
      }
    },
    {
      "name": "sqlUsername",
      "type": "string",
      "label": "SQL Username",
      "defaultValue": "",
      "required": true,
      "helpMarkDown": "SQL Server username for authentication",
      "visibleRule": "authenticationType = sqlServerAuthentication"
    },
    {
      "name": "sqlPassword",
      "type": "string",
      "label": "SQL Password",
      "defaultValue": "",
      "required": true,
      "helpMarkDown": "SQL Server password. Use a secret variable for secure storage",
      "visibleRule": "authenticationType = sqlServerAuthentication"
    },
    {
      "name": "connectionString",
      "type": "string",
      "label": "Connection String",
      "defaultValue": "",
      "required": true,
      "helpMarkDown": "Full SQL Server connection string",
      "visibleRule": "targetMethod = connectionString"
    },
    {
      "name": "publishProfile",
      "type": "filePath",
      "label": "Publish Profile",
      "defaultValue": "",
      "required": false,
      "helpMarkDown": "Optional: Path to a publish profile XML file (.publish.xml) with deployment settings"
    },
    {
      "name": "additionalArguments",
      "type": "multiLine",
      "label": "Additional Arguments",
      "defaultValue": "",
      "required": false,
      "helpMarkDown": "Additional SqlPackage.exe arguments. Example: /p:BlockOnPossibleDataLoss=false /p:DropObjectsNotInSource=true"
    }
  ],
  "execution": {
    "Node20_1": {
      "target": "index.js"
    }
  }
}
